# —— 必填 ——
# PostgreSQL 连接串（角色 crm / 库 crm_admin，密码见服务器 .env）
DATABASE_URL=postgresql+psycopg://crm:CHANGE_ME@127.0.0.1:5432/crm_admin
# JWT 签名密钥：随机长串，生成方式 python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
# 后台种子管理员初始密码（init_db.py 用），上线务必设强密码
ADMIN_INIT_PASSWORD=CHANGE_ME

# —— 可选（以下为默认值，需要时取消注释覆盖）——
# JWT_EXPIRE_MINUTES=720
# 附件根目录（生产用 /data/crm/media）
# MEDIA_ROOT=/data/crm/media
# CORS 白名单，逗号分隔；上线收紧为具体前端域名
# CORS_ORIGINS=https://crm.qlzby.com
